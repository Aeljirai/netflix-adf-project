{
	"name": "pl_incremental_fact_rating",
	"properties": {
		"activities": [
			{
				"name": "lookup_old_watermark",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT watermark_value FROM gold.etl_watermark WHERE table_name = 'fact_rating'",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_azuresql_table_generic",
						"type": "DatasetReference",
						"parameters": {
							"schema_name": "gold",
							"table_name": "etl_watermark"
						}
					}
				}
			},
			{
				"name": "df_load_new_ratings",
				"type": "ExecuteDataFlow",
				"dependsOn": [
					{
						"activity": "lookup_old_watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "df_incremental_fact_rating",
						"type": "DataFlowReference",
						"parameters": {
							"watermark": {
								"value": "'@{  @formatDateTime(activity('lookup_old_watermark').output.firstRow.watermark_value, 'yyyy-MM-dd HH:mm:ss')}'",
								"type": "Expression"
							}
						},
						"datasetParameters": {
							"srcRatings": {
								"container": "silver",
								"directory": "movielens/ratings"
							},
							"sinkFactRating": {
								"schema_name": "gold",
								"table_name": "fact_rating"
							}
						}
					},
					"compute": {
						"coreCount": 8,
						"computeType": "General"
					},
					"traceLevel": "Fine"
				}
			},
			{
				"name": "update_watermark",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "df_load_new_ratings",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ls_azuresql_netflix",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "NonQuery",
							"text": "  UPDATE gold.etl_watermark\n  SET watermark_value = (SELECT MAX(rated_at) FROM gold.fact_rating),\n      updated_at      = SYSUTCDATETIME()\n  WHERE table_name = 'fact_rating';"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"annotations": []
	}
}