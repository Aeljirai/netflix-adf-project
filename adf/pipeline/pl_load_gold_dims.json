							{
								"source": {
									"name": "movie-Id",
									"type": "Int32",
									"physicalType": "INT32"
								},
								"sink": {
									"name": "movie_id",
									"type": "Int32",
									"physicalType": "int"
								}
							},
							{
								"source": {
									"name": "Title",
									"type": "String",
									"physicalType": "UTF8"
								},
								"sink": {
									"name": "title",
									"type": "String",
									"physicalType": "nvarchar"
								}
							},
							{
								"source": {
									"name": "release_year",
									"type": "Int32",
									"physicalType": "INT32"
								},
								"sink": {
									"name": "release_year",
									"type": "Int16",
									"physicalType": "smallint"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_adls_parquet_generic",
						"type": "DatasetReference",
						"parameters": {
							"container": "silver",
							"directory": "movielens/movies"
						}
					}
