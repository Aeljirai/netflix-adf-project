{
	"name": "pl_master_movielens",
	"properties": {
		"activities": [
			{
				"name": "set_run_date",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "run_date",
					"value": {
						"value": "@formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "exec_ingest",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "set_run_date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_ingest_movielens_dynamic",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"ingest_date": {
							"value": "@variables('run_date')",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "exec_transform",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "exec_ingest",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_transform_movies_silver",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"ingest_date": {
							"value": "@variables('run_date')",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "exec_load_dims",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "exec_transform",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_load_gold_dims",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "exec_load_fact",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "exec_transform",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_incremental_fact_rating",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "exec_aggregates",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "exec_load_fact",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "exec_load_dims",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_build_gold_aggregates",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "check_agg_rows",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "exec_aggregates",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT COUNT(*) AS n FROM gold.agg_movie_stats",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_azuresql_table_generic",
						"type": "DatasetReference",
						"parameters": {
							"schema_name": "gold",
							"table_name": "agg_movie_stats"
						}
					}
				}
			},
			{
				"name": "if_agg_empty",
				"description": "",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "check_agg_rows",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@less(activity('check_agg_rows').output.firstRow.n, 1000)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "fail_dq_agg_empty",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "Data quality check failed: gold.agg_movie_stats has fewer than 1000 rows",
								"errorCode": "DQ_AGG_EMPTY"
							}
						}
					]
				}
			}
		],
		"variables": {
			"run_date": {
				"type": "String"
			}
		},
		"annotations": []
	}
}