		{
			"name": "[concat(parameters('factoryName'), '/df_gold_aggregates')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_adls_parquet_generic",
								"type": "DatasetReference"
							},
							"name": "srcRatings"
						},
						{
							"dataset": {
