					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": "Ratings.csv",
						"folderPath": "ratings",
						"fileSystem": "bronze"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
