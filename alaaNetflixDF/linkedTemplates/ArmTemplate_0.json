			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Phase 1 – copy movies.csv from landing to bronze",
				"activities": [
					{
						"name": "Copy movies",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
