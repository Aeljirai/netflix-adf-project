{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "alaaNetflixDF"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pl_transform_movies_silver')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "df_movies_to_silver",
						"type": "ExecuteDataFlow",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataflow": {
								"referenceName": "df_movies_bronze_to_silve",
								"type": "DataFlowReference",
								"parameters": {},
								"datasetParameters": {
									"srcMovies": {
										"container": "bronze",
										"directory": "@concat('movielens/movies/ingest_date=', pipeline().parameters.ingest_date)",
										"file_name": "movies.csv"
									},
									"sinkSilverMovies": {
										"container": "silver",
										"directory": "movielens/movies"
									},
									"sinkSilverMovieGenres": {
										"container": "silver",
										"directory": "movielens/movie_genres"
									}
								}
							},
							"staging": {},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
							},
							"traceLevel": "Fine"
						}
					},
					{
						"name": "df_ratings_to_silver",
						"type": "ExecuteDataFlow",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataflow": {
								"referenceName": "df_ratings_bronze_to_silver",
								"type": "DataFlowReference",
								"parameters": {},
								"datasetParameters": {
									"srcRatings": {
										"container": "bronze",
										"directory": "@concat('movielens/ratings/ingest_date=', pipeline().parameters.ingest_date)",
										"file_name": "ratings.csv"
									},
									"sinkSilverRatings": {
										"container": "silver",
										"directory": "movielens/ratings"
									}
								}
							},
							"staging": {},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
							},
							"traceLevel": "Fine"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"ingest_date": {
						"type": "string",
						"defaultValue": "2026-10-23"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-10-20T03:00:15Z"
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_master_movielens')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "set_run_date",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "run_date",
							"value": {
								"value": "@formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd')",
								"type": "Expression"
							}
						}
					},
					{
						"name": "exec_ingest",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "set_run_date",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "pl_ingest_movielens_dynamic",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"ingest_date": {
									"value": "@variables('run_date')",
									"type": "Expression"
								}
							}
						}
					},
					{
						"name": "exec_transform",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "exec_ingest",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "pl_transform_movies_silver",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"ingest_date": {
									"value": "@variables('run_date')",
									"type": "Expression"
								}
							}
						}
					},
					{
						"name": "exec_load_dims",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "exec_transform",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "pl_load_gold_dims",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {}
						}
					},
					{
						"name": "exec_load_fact",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "exec_transform",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "pl_incremental_fact_rating",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {}
						}
					},
					{
						"name": "exec_aggregates",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "exec_load_fact",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "exec_load_dims",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "pl_build_gold_aggregates",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {}
						}
					},
					{
						"name": "check_agg_rows",
						"type": "Lookup",
						"dependsOn": [
							{
								"activity": "exec_aggregates",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": "SELECT COUNT(*) AS n FROM gold.agg_movie_stats",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "ds_azuresql_table_generic",
								"type": "DatasetReference",
								"parameters": {
									"schema_name": "gold",
									"table_name": "agg_movie_stats"
								}
							}
						}
					},
					{
						"name": "if_agg_empty",
						"description": "",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "check_agg_rows",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@less(activity('check_agg_rows').output.firstRow.n, 1000)",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "fail_dq_agg_empty",
									"type": "Fail",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"message": "Data quality check failed: gold.agg_movie_stats has fewer than 1000 rows",
										"errorCode": "DQ_AGG_EMPTY"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"run_date": {
						"type": "string"
					}
				},
				"variables": {
					"run_date": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/pipelines/pl_transform_movies_silver')]"
			]
		}
	]
}