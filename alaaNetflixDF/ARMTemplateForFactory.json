								"writeBehavior": "insert",
								"sqlWriterUseTableLock": false,
								"disableMetricsCollection": false
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"mappings": [
									{
										"source": {
											"name": "movie_id",
											"type": "Int32",
											"physicalType": "INT32"
										},
										"sink": {
											"name": "movie_id",
											"type": "Int32",
