{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "alaaNetflixDF"
		},
		"ls_adls_netflix_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://alaa0netflixdata.dfs.core.windows.net/"
		},
		"ls_azuresql_netflix_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-netflix-alaa-weu.database.windows.net"
		},
		"ls_azuresql_netflix_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-netflix-gold"
		},
		"ls_keyvault_netflix_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-netflix-alaa.vault.azure.net/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pl_build_gold_aggregates')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "df_gold_aggregates_run",
						"type": "ExecuteDataFlow",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataflow": {
								"referenceName": "df_gold_aggregates",
								"type": "DataFlowReference",
								"parameters": {},
								"datasetParameters": {
									"srcRatings": {
										"container": "silver",
										"directory": "movielens/ratings"
									},
									"srcMovies": {
										"container": "silver",
										"directory": "movielens/movies"
									},
									"srcGenres": {
										"container": "silver",
										"directory": "movielens/movie_genres"
									},
									"sinkAggMovieStats": {
										"schema_name": "gold",
										"table_name": "agg_movie_stats"
									},
									"sinkAggGenreYear": {
										"schema_name": "gold",
										"table_name": "agg_genre_year"
									}
								}
							},
							"staging": {},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
							},
							"traceLevel": "Fine"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/dataflows/df_gold_aggregates')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_incremental_fact_rating')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "lookup_old_watermark",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 60,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": "SELECT watermark_value FROM gold.etl_watermark WHERE table_name = 'fact_rating'",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "ds_azuresql_table_generic",
								"type": "DatasetReference",
								"parameters": {
									"schema_name": "gold",
									"table_name": "etl_watermark"
								}
							}
						}
					},
					{
						"name": "df_load_new_ratings",
						"type": "ExecuteDataFlow",
						"dependsOn": [
							{
								"activity": "lookup_old_watermark",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 1,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataflow": {
								"referenceName": "df_incremental_fact_rating",
								"type": "DataFlowReference",
								"parameters": {
									"watermark": {
										"value": "'@{formatDateTime(activity('lookup_old_watermark').output.firstRow.watermark_value, 'yyyy-MM-dd HH:mm:ss')}'",
										"type": "Expression"
									}
								},
								"datasetParameters": {
									"srcRatings": {
										"container": "silver",
										"directory": "movielens/ratings"
									},
									"sinkFactRating": {
										"schema_name": "gold",
										"table_name": "fact_rating"
									}
								}
							},
							"staging": {},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
							},
							"traceLevel": "Fine"
						}
					},
					{
						"name": "update_watermark",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "df_load_new_ratings",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "ls_azuresql_netflix",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "NonQuery",
									"text": "  UPDATE gold.etl_watermark\n  SET watermark_value = (SELECT MAX(rated_at) FROM gold.fact_rating),\n      updated_at      = SYSUTCDATETIME()\n  WHERE table_name = 'fact_rating';"
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_azuresql_table_generic')]",
				"[concat(variables('factoryId'), '/dataflows/df_incremental_fact_rating')]",
				"[concat(variables('factoryId'), '/linkedServices/ls_azuresql_netflix')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_ingest_movielens_dynamic')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "lookup_file_list",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "JsonSource",
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "JsonReadSettings"
								}
							},
							"dataset": {
								"referenceName": "ds_adls_json_config",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "Foreach_File",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "lookup_file_list",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('lookup_file_list').output.value",
								"type": "Expression"
							},
							"batchCount": 2,
							"activities": [
								{
									"name": "get_file_metadata",
									"type": "GetMetadata",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"dataset": {
											"referenceName": "ds_adls_csv_generic",
											"type": "DatasetReference",
											"parameters": {
												"container": "landing",
												"directory": "@item().source_folder",
												"file_name": "@item().file_name"
											}
										},
										"fieldList": [
											"exists"
										],
										"storeSettings": {
											"type": "AzureBlobFSReadSettings",
											"recursive": true,
											"enablePartitionDiscovery": false
										},
										"formatSettings": {
											"type": "DelimitedTextReadSettings"
										}
									}
								},
								{
									"name": "if_file_exists",
									"type": "IfCondition",
									"dependsOn": [
										{
											"activity": "get_file_metadata",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"expression": {
											"value": "@activity('get_file_metadata').output.exists",
											"type": "Expression"
										},
										"ifFalseActivities": [
											{
												"name": "skipped_file",
												"type": "AppendVariable",
												"dependsOn": [],
												"userProperties": [],
												"typeProperties": {
													"variableName": "skipped_files",
													"value": {
														"value": "@item().file_name",
														"type": "Expression"
													}
												}
											}
										],
										"ifTrueActivities": [
											{
												"name": "copy_file_to_bronze",
												"type": "Copy",
												"dependsOn": [],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 1,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "DelimitedTextSource",
														"storeSettings": {
															"type": "AzureBlobFSReadSettings",
															"recursive": true,
															"enablePartitionDiscovery": false
														},
														"formatSettings": {
															"type": "DelimitedTextReadSettings"
														}
													},
													"sink": {
														"type": "DelimitedTextSink",
														"storeSettings": {
															"type": "AzureBlobFSWriteSettings"
														},
														"formatSettings": {
															"type": "DelimitedTextWriteSettings",
															"quoteAllText": true,
															"fileExtension": ".txt"
														}
													},
													"enableStaging": false,
													"translator": {
														"type": "TabularTranslator",
														"typeConversion": true,
														"typeConversionSettings": {
															"allowDataTruncation": true,
															"treatBooleanAsNumber": false
														}
													}
												},
												"inputs": [
													{
														"referenceName": "ds_adls_csv_generic",
														"type": "DatasetReference",
														"parameters": {
															"container": "landing",
															"directory": "@item().source_folder",
															"file_name": "@item().file_name"
														}
													}
												],
												"outputs": [
													{
														"referenceName": "ds_adls_csv_generic",
														"type": "DatasetReference",
														"parameters": {
															"container": "bronze",
															"directory": {
																"value": "@concat('movielens/', item().table_name, '/ingest_date=', pipeline().parameters.ingest_date)",
																"type": "Expression"
															},
															"file_name": "@item().file_name"
														}
													}
												]
											}
										]
									}
								}
							]
						}
					},
					{
						"name": "if_any_skipped",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "Foreach_File",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@greater(length(variables('skipped_files')), 0)",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "fail_missing_files",
									"type": "Fail",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"message": {
											"value": "@concat('Ingestion finished, but these source files were missing in landing: ', join(variables('skipped_files'), ', '))",
											"type": "Expression"
										},
										"errorCode": "MISSING_SOURCE_FILES"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"ingest_date": {
						"type": "string",
						"defaultValue": "2026-10-23"
					}
				},
				"variables": {
					"skipped_files": {
						"type": "Array"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-10-18T15:27:51Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_adls_json_config')]",
				"[concat(variables('factoryId'), '/datasets/ds_adls_csv_generic')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_load_gold_dims')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "copy_dim_movie",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 1,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "ParquetSource",
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
