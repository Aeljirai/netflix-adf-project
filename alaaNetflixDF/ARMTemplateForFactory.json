			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_master_movielens')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "set_run_date",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "run_date",
							"value": {
								"value": "@formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd')",
								"type": "Expression"
							}
						}
					},
					{
						"name": "exec_ingest",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "set_run_date",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "pl_ingest_movielens_dynamic",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"ingest_date": {
									"value": "@variables('run_date')",
									"type": "Expression"
								}
							}
						}
					},
					{
						"name": "exec_transform",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "exec_ingest",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "pl_transform_movies_silver",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"ingest_date": {
									"value": "@variables('run_date')",
									"type": "Expression"
								}
							}
						}
					},
					{
						"name": "exec_load_dims",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "exec_transform",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "pl_load_gold_dims",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {}
