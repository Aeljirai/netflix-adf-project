		{
			"name": "[concat(parameters('factoryName'), '/df_gold_aggregates')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_adls_parquet_generic",
								"type": "DatasetReference"
							},
							"name": "srcRatings"
						},
						{
							"dataset": {
								"referenceName": "ds_adls_parquet_generic",
								"type": "DatasetReference"
							},
							"name": "srcMovies"
						},
						{
							"dataset": {
								"referenceName": "ds_adls_parquet_generic",
								"type": "DatasetReference"
							},
							"name": "srcGenres"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_azuresql_table_generic",
								"type": "DatasetReference"
							},
							"name": "sinkAggMovieStats"
						},
						{
							"dataset": {
								"referenceName": "ds_azuresql_table_generic",
								"type": "DatasetReference"
							},
							"name": "sinkAggGenreYear"
						}
					],
					"transformations": [
						{
							"name": "aggByMovie"
						},
						{
							"name": "joinMovieTitle"
						},
						{
							"name": "joinGenre"
						},
						{
							"name": "aggByGenreYear"
						}
					],
					"scriptLines": [
						"source(output(",
						"          user_Id as integer,",
						"          movie_Id as integer,",
						"          rating as double,",
						"          rated_at as timestamp,",
						"          rating_year as integer,",
						"          rated_date as date,",
						"          rated_day_of_week as integer,",
						"          rated_day_name as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet') ~> srcRatings",
						"source(output(",
						"          movie_id as integer,",
						"          title as string,",
						"          genres as string,",
						"          release_year as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet') ~> srcMovies",
						"source(output(",
						"          movie_id as integer,",
						"          genre as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet') ~> srcGenres",
						"srcRatings aggregate(groupBy({movie-id} = movie_Id),",
						"     rating_count = count(),",
						"          avg_rating = round(avg(rating), 2),",
						"          first_rated_date = min(rated_date),",
						"          last_rated_date = max(rated_date)) ~> aggByMovie",
						"aggByMovie, srcMovies join({movie-id} == movie_id,",
						"     joinType:'inner',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> joinMovieTitle",
						"srcRatings, srcGenres join(srcRatings@movie_Id == srcGenres@movie_id,",
						"     joinType:'inner',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> joinGenre",
						"joinGenre aggregate(groupBy(genre,",
						"          rating_year),",
						"     rating_count = count(),",
						"          avg_rating = round(avg(rating), 2)) ~> aggByGenreYear",
						"joinMovieTitle sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     truncate:true,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          rating_count,",
						"          avg_rating,",
						"          first_rated_date,",
						"          last_rated_date,",
						"          movie_id,",
						"          title",
						"     )) ~> sinkAggMovieStats",
						"aggByGenreYear sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     truncate:true,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sinkAggGenreYear"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_adls_parquet_generic')]",
				"[concat(variables('factoryId'), '/datasets/ds_azuresql_table_generic')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_incremental_fact_rating')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_adls_parquet_generic",
								"type": "DatasetReference"
							},
							"name": "srcRatings"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_azuresql_table_generic",
								"type": "DatasetReference"
							},
							"name": "sinkFactRating"
						}
					],
					"transformations": [
						{
							"name": "filterNewRatings"
						}
					],
					"scriptLines": [
						"parameters{",
						"     watermark as string ('1900-01-01 00:00:00')",
						"}",
						"source(output(",
						"          user_Id as integer,",
						"          movie_Id as integer,",
						"          rating as double,",
						"          rated_at as timestamp,",
						"          rating_year as integer,",
						"          rated_date as date,",
						"          rated_day_of_week as integer,",
						"          rated_day_name as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet') ~> srcRatings",
						"srcRatings filter(rated_at > toTimestamp($watermark, 'yyyy-MM-dd HH:mm:ss')) ~> filterNewRatings",
						"filterNewRatings sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          user_id = user_Id,",
						"          movie_id = movie_Id,",
						"          rating,",
						"          rated_at,",
						"          rated_date",
						"     )) ~> sinkFactRating"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_adls_parquet_generic')]",
				"[concat(variables('factoryId'), '/datasets/ds_azuresql_table_generic')]"
			]
		},
		{
